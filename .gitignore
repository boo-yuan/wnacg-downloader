# Python bytecode and native extensions
__pycache__/
*.py[cod]
*.so

# uv-managed local environment and environment secrets
.venv/
.env
.env.*
!.env.example

# Test, coverage, lint, and type-checker caches
.cache/
.codex-pytest-tmp/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Python packaging and local PyInstaller output
build/
dist/
*.egg-info/
*.egg
*.manifest
*.spec

# Application runtime data created in or migrated from the repository
/app.log
/app.jsonl
/config.json
/config.invalid-*.json
/tasks.db
/tasks.db-*
/data/
/downloads/
/.temp_covers/

# Editor and operating-system files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# uv.lock is intentionally committed for reproducible installs and builds.
!uv.lock
